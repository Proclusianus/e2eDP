graph TB
    subgraph Host ["Host System (Windows / WSL2)"]
        subgraph LocalFiles ["Local Project Workspace"]
            SQL["./sql (DB Management)"]
            SRC["./src (Python Modules)"]
            ENV[".env (Configuration)"]
        end
    end

    subgraph Docker ["Docker Infrastructure (pricing_network)"]
        subgraph UI_Cont ["Container: pricing_dashboard"]
            Streamlit_UI["Streamlit Dashboard UI"]
        end

        subgraph App_Cont ["Container: pricing_airflow"]
            AF_Runtime["Airflow Standalone Orchestrator"]
            subgraph Logic ["Execution Layer"]
                Python_Scripts["Custom Python Scripts (Scraper, ETL, Analyzer)"]
                PW_Engine["Playwright + Chromium"]
            end
        end

        subgraph DB_Cont ["Container: pricing_postgres"]
            DB_Engine["PostgreSQL 15 Engine"]
        end
        
        DB_Vol[("Volume: postgres_data")]

        subgraph VPN_Cont ["Container: pricing_vpn_gateway"]
            VPN_Engine["Gluetun VPN (SOCKS5/HTTP Proxy)"]
        end
    end

    subgraph Internet ["External World"]
        RE_Websites["Real Estate Listing Websites"]
    end

    %% Positioning
    LocalFiles ~~~ Docker
    Docker ~~~ Internet

    %% Relations
    SQL -- "Schema & Data Management" --> DB_Engine
    SRC -- "Live Mounting" --> Python_Scripts
    SRC -- "Live Mounting" --> Streamlit_UI
    ENV -- "Environment Injection" --> AF_Runtime
    
    DB_Engine -- "Persists Data To" --> DB_Vol
    Python_Scripts -- "SQL Transactions" --> DB_Engine
    Streamlit_UI -- "Read & Config Access" --> DB_Engine
    
    AF_Runtime -- "Triggers & Schedules" --> Python_Scripts
    Python_Scripts -- "Uses for Web Interaction" --> PW_Engine
    
    PW_Engine -- "Traffic via SOCKS5/HTTP" --> VPN_Engine
    VPN_Engine -- "Encrypted Scraping Request" --> RE_Websites

    style Docker fill:#f9f9f9,stroke:#333,stroke-width:2px
    style Host fill:#e1f5fe,stroke:#01579b
    style DB_Vol fill:#fff9c4,stroke:#fbc02d
    style Logic fill:#f1f8e9,stroke:#33691e
    style UI_Cont fill:#fff0f0,stroke:#d32f2f
    style VPN_Cont fill:#e8f5e9,stroke:#2e7d32